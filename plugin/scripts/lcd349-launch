#!/bin/sh
# lcd349-launch: run the lcd349 binary that matches this plugin's version.
#
# 1. If `lcd349` on PATH reports exactly this version (`lcd349 version`
#    prints "lcd349 <version>"), run it.
# 2. Otherwise use the release binary for this OS and CPU from
#    $CLAUDE_PLUGIN_DATA/bin, downloading it first if it is missing.
# 3. Never run a binary whose SHA-256 differs from checksums.txt, which ships
#    inside the plugin.
#
# stdout belongs to the MCP server: this script writes only to stderr.
# LCD349_RELEASE_BASE overrides the download location, and
# LCD349_DOWNLOAD_MAX_TIME its time limit in seconds (tests only).
set -eu

VERSION="0.2.2"
DEFAULT_BASE="https://github.com/MaverickHQ/lcd349-kit/releases/download/v$VERSION"

here=$(CDPATH='' cd -- "$(dirname -- "$0")" && pwd)

die() {
	echo "lcd349-launch: $*" >&2
	exit 1
}

if command -v lcd349 >/dev/null 2>&1; then
	if [ "$(lcd349 version 2>/dev/null || true)" = "lcd349 $VERSION" ]; then
		exec lcd349 "$@"
	fi
fi

case $(uname -s) in
Darwin) os=darwin ;;
Linux) os=linux ;;
*) die "unsupported OS $(uname -s); install lcd349 $VERSION on PATH" ;;
esac
case $(uname -m) in
x86_64 | amd64) arch=amd64 ;;
arm64 | aarch64) arch=arm64 ;;
*) die "unsupported CPU $(uname -m); install lcd349 $VERSION on PATH" ;;
esac

asset="lcd349_${VERSION}_${os}_${arch}"
[ -n "${CLAUDE_PLUGIN_DATA:-}" ] || die "CLAUDE_PLUGIN_DATA is not set; install lcd349 $VERSION on PATH"
bin="$CLAUDE_PLUGIN_DATA/bin/$asset"

want=$(awk -v a="$asset" '$2 == a { print $1 }' "$here/checksums.txt")
[ -n "$want" ] || die "no checksum for $asset in $here/checksums.txt (a development plugin has none: install lcd349 $VERSION on PATH)"

sha256() {
	if command -v sha256sum >/dev/null 2>&1; then
		sha256sum "$1" | awk '{ print $1 }'
	else
		shasum -a 256 "$1" | awk '{ print $1 }'
	fi
}

# fetch downloads $1 to $tmp, within a time limit. curl runs in the
# background so that a TERM or INT (Claude Code ending the session) stops the
# wait at once; the traps then stop curl and remove the partial file.
fetch() {
	curl -fsSL --connect-timeout 30 --max-time "${LCD349_DOWNLOAD_MAX_TIME:-600}" "$@" -o "$tmp" &
	curl_pid=$!
	wait "$curl_pid"
}

cleanup() {
	if [ -n "${curl_pid:-}" ]; then
		kill "$curl_pid" 2>/dev/null || true
	fi
	rm -f "$tmp"
}

if [ ! -f "$bin" ] || [ "$(sha256 "$bin")" != "$want" ]; then
	mkdir -p "$CLAUDE_PLUGIN_DATA/bin"
	tmp="$bin.part.$$"
	trap cleanup EXIT
	trap 'cleanup; exit 130' INT
	trap 'cleanup; exit 143' TERM
	if [ -n "${LCD349_RELEASE_BASE:-}" ]; then
		fetch --proto '=https,http,file' "$LCD349_RELEASE_BASE/$asset" ||
			die "download from $LCD349_RELEASE_BASE/$asset failed"
	else
		fetch --proto '=https' --tlsv1.2 "$DEFAULT_BASE/$asset" ||
			die "download from $DEFAULT_BASE/$asset failed"
	fi
	curl_pid=
	got=$(sha256 "$tmp")
	[ "$got" = "$want" ] || die "checksum mismatch for $asset: expected $want, got $got; refusing to run it"
	chmod 755 "$tmp"
	mv -f "$tmp" "$bin"
	trap - EXIT INT TERM
fi

exec "$bin" "$@"
